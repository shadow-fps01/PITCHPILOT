# ─────────────────────────────────────────────────────────────────────────────
# PitchPilot — local development secrets
#
#   copy .env.example .env
#   # then paste your own keys (never commit .env — it is git-ignored)
#
# App behaviour (providers, limits, CORS, …) lives in backend/.env; see
# backend/.env.example. Production values live in .env.production.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core security ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_MINUTES=1440

# ── Database (Supabase pooler; URL-encode the password, e.g. # → %23) ────────
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ── Speech-to-text (Groq is the recommended provider) ───────────────────────
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── LLM providers (script auditor + copilot) ─────────────────────────────────
# gpt-4o on Azure OpenAI is the primary backend in production.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional failover:
OPENROUTER_API_KEY=
AZURE_OPENAI_STT_DEPLOYMENT=
AZURE_OPENAI_STT_API_VERSION=2024-06-01

# ── Live web search (Tavily) ─────────────────────────────────────────────────
SEARCH_ENABLED=true
TAVILY_API_KEY=

# ── Knowledge cards (RAG embeddings) ─────────────────────────────────────────
GEMINI_API_KEY=

# ── Screen vision fallback (optional) ────────────────────────────────────────
NVIDIA_API_KEY=

# ── Billing ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
PLUS_PRICE_AMOUNT=2250000
PLUS_PRICE_DISPLAY=₦22,500

# ── Transactional email (optional locally) ───────────────────────────────────
# smtp (default) or resend (HTTPS API; use on hosts that block SMTP).
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
