# ─────────────────────────────────────────────────────────────
# PitchPilot Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NOTE: values that are JSON lists (e.g. FILLER_WORDS) must be
# written as JSON, e.g. FILLER_WORDS=["um","uh","like"]
# ─────────────────────────────────────────────────────────────

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ── Database (PostgreSQL) ──
# Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchpilot
# Supabase via the session-mode pooler (recommended; the direct
# db.<ref>.supabase.co host is IPv6-only). Username is postgres.<project-ref>,
# password must be URL-encoded (# -> %23):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:YourPass%23@aws-1-<region>.pooler.supabase.com:5432/postgres
# Optional: auto-create tables on startup (dev convenience — use Alembic in prod)
AUTO_CREATE_TABLES=true

# ── CORS (JSON list) ──
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Speech-to-Text provider: auto | azure | deepgram | openai | groq | mock ──
# "auto" uses Deepgram if DEEPGRAM_API_KEY is set, else Groq if GROQ_API_KEY is
# set, else Azure OpenAI if the shared Azure key/endpoint +
# AZURE_OPENAI_STT_DEPLOYMENT are set, else OpenAI Realtime, else the built-in
# mock provider (demo mode).
STT_PROVIDER=auto
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Groq (near-real-time via rolling segments against whisper-large-v3-turbo)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_SEGMENT_SECONDS=3
# Azure OpenAI STT (reuses AZURE_OPENAI_API_KEY / AZURE_OPENAI_ENDPOINT below).
# The deployment is the name you gave the audio model in Azure, not the model
# name. Create a Whisper or gpt-4o-transcribe deployment, then set its name.
# Empty = Azure STT is not selected by STT_PROVIDER=auto.
AZURE_OPENAI_STT_DEPLOYMENT=
# AZURE_OPENAI_STT_DEPLOYMENT=whisper
AZURE_OPENAI_STT_API_VERSION=2024-06-01
AZURE_OPENAI_STT_SEGMENT_SECONDS=3

# ── Live coaching analytics ──
WPM_WINDOW_SECONDS=5
TARGET_WPM_DEFAULT=140
FILLER_WORDS=["um","uh","like","so","you know","basically","actually","literally"]
FILLER_BURST_WINDOW_SECONDS=15
FILLER_BURST_THRESHOLD=3
PACING_TICK_SECONDS=3

# ── Script Auditor LLM: auto | azure | openrouter | heuristic ──
# "auto" prefers Azure OpenAI when configured, falls back to OpenRouter,
# then to a local keyword-matching heuristic (always works, no keys needed).
LLM_PROVIDER=auto
SCRIPT_AUDIT_WORD_INTERVAL=45
SCRIPT_AUDIT_MIN_GAP_SECONDS=30
SCRIPT_AUDIT_CONTEXT_WORDS=120

# Azure OpenAI (chat completions)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── WebSocket resilience ──
# Grace period the server keeps a live session alive after a disconnect,
# so the client can reconnect mid-call and resume the same session.
WS_RECONNECT_GRACE_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=40

# ── Copilot upgrades ──
# F1: native dual audio capture (mic + system loopback, mixed server-side)
AUDIO_CAPTURE_ENABLED=false
CAPTURE_MIC_NAME=
CAPTURE_LOOPBACK_NAME=
CAPTURE_FRAME_MS=50
# F3: next-topic RAG anticipation (GEMINI_API_KEY from the workspace-root .env;
# falls back to keyword search without it)
ANTICIPATION_ENABLED=true
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
RAG_COOLDOWN_SECONDS=25
# F5: screen-vision worker — opt-in, sends screen frames to Gemini
VISION_ENABLED=false
VISION_MODEL=gemini-3.5-flash
VISION_INTERVAL_SECONDS=2
VISION_MIN_INTERVAL_CALLS=12

# ── Account lifecycle / signups / recording consent ──
# Close public registration for a private pilot, or restrict it to an allowlist
# (JSON list of email addresses). Existing accounts can always sign in.
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=[]
# Password-reset links expire after this many minutes (single-use).
PASSWORD_RESET_TOKEN_MINUTES=30
# The app captures audio and sends it to a transcription provider. Keep this
# on unless your own consent flow already covers every participant.
REQUIRE_RECORDING_CONSENT=true
CONSENT_VERSION=2026-10-24

# ── Misc ──
DEBUG=false

# ── Deployment / runtime safety ──
# development | production. In production the API refuses to boot with
# insecure defaults (default JWT secret, AUTO_CREATE_TABLES=true,
# wildcard/localhost CORS, localhost public URLs).
ENVIRONMENT=development

# ── Abuse protection (in-process, per-IP) ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=12
# Short-lived credential for WebSocket handshakes (keeps JWTs out of URLs).
WS_TICKET_TTL_SECONDS=900

# ── Email verification (opt-in) ──
# When enabled, new accounts must confirm their address before starting a
# coaching session. Use EMAIL_PROVIDER=smtp on a VPS, or resend on hosts that
# block outbound SMTP (Render Free). Resend needs a verified EMAIL_FROM domain.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=PitchPilot <no-reply@pitchpilot.app>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Trust X-Forwarded-For only when the API is reachable exclusively through a
# trusted reverse proxy (Render/nginx). The limiter uses the rightmost entry.
TRUST_PROXY_HEADERS=false

