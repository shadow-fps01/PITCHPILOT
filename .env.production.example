# ─────────────────────────────────────────────────────────────────────────────
# PitchPilot — production environment
#
#   cp .env.production.example .env.production
#   # fill in every <placeholder>, then:
#   docker compose up -d --build
#
# This file is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# production ⇒ the app refuses to start with insecure defaults.
ENVIRONMENT=production

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<64-hex-char-secret>
JWT_ALGORITHM=HS256
# Keep sessions short in production; 1440 = 24 hours (hard maximum).
JWT_EXPIRES_MINUTES=1440

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# Example (Supabase pooler — password must be URL-encoded, e.g. # → %23):
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# Schema changes are applied by Alembic in the entrypoint.
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Public URLs / host allowlist / CORS ──────────────────────────────────────
# The exact origin users open in the browser (no trailing slash).
FRONTEND_BASE_URL=https://app.example.com
# JSON list; must not contain "*" or localhost in production.
CORS_ORIGINS=["https://app.example.com"]
# Host headers the API will answer to (DNS-rebinding protection).
ALLOWED_HOSTS=["api.example.com"]

# ── Abuse protection ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# "db" is required in production so every API instance shares the budget.
RATE_LIMIT_BACKEND=db
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=12
# 60s tickets are minted immediately before each WebSocket handshake.
WS_TICKET_TTL_SECONDS=60
# Per-user UTC-day paid-AI budgets (0 disables a budget).
DAILY_SESSION_LIMIT=6
DAILY_ASK_LIMIT=100
MAX_CONCURRENT_SESSIONS=20
# Reject oversized JSON bodies before they are parsed.
MAX_HTTP_BODY_BYTES=1000000

# ── Signups / account lifecycle / recording consent ─────────────────────────
# Private pilot: set SIGNUPS_ENABLED=false (existing accounts still sign in)
# or keep it true and list invited addresses in SIGNUP_ALLOWLIST.
SIGNUPS_ENABLED=false
SIGNUP_ALLOWLIST=[]
PASSWORD_RESET_TOKEN_MINUTES=30
REQUIRE_RECORDING_CONSENT=true
CONSENT_VERSION=2026-10-24

# ── Data retention / abandoned sessions ─────────────────────────────────────
# Keep this true in production: transcript excerpts/coaching notes older than
# DATA_RETENTION_DAYS are deleted, and abandoned sessions are closed after
# STALE_SESSION_HOURS. Session summaries remain.
DATA_RETENTION_DAYS=30
STALE_SESSION_HOURS=12
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_HOURS=24

# ── Speech-to-text (Groq; free tier, OpenAI-compatible) ──────────────────────
STT_PROVIDER=groq
GROQ_API_KEY=<groq-key>
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_SEGMENT_SECONDS=3
# Alternatives:
# Deepgram live streaming:
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=<deepgram-key>
# OpenAI Realtime:
# STT_PROVIDER=openai
# OPENAI_API_KEY=<openai-key>
# Azure OpenAI (requires an audio deployment in the resource):
# STT_PROVIDER=azure
# AZURE_OPENAI_STT_DEPLOYMENT=<azure-audio-deployment>
# AZURE_OPENAI_STT_API_VERSION=2024-06-01
# AZURE_OPENAI_STT_SEGMENT_SECONDS=3

# ── Live script auditing / copilot (LLM) ─────────────────────────────────────
# gpt-4o on Azure OpenAI is the required production backend. OpenRouter is an
# optional failover only; the app never invents cues when both are offline.
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=<azure-key>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional failover:
# OPENROUTER_API_KEY=<openrouter-key>
# OPENROUTER_MODEL=openai/gpt-4o-mini

COPILOT_ENABLED=true
COPILOT_STREAM_ANSWERS=true
DEBRIEF_ENABLED=true

# ── Live web search (Tavily) ─────────────────────────────────────────────────
# Required when SEARCH_ENABLED=true. Set false to run without live search.
SEARCH_ENABLED=true
TAVILY_API_KEY=<tavily-key>

# ── Knowledge cards (RAG) ────────────────────────────────────────────────────
ANTICIPATION_ENABLED=true
GEMINI_API_KEY=<gemini-key>
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45

# ── Audio capture and screen vision ─────────────────────────────────────────
# Native/server capture stays OFF in containers. Browser screen sharing is on:
# the client sends screen/tab + system-audio frames over the live WebSocket.
AUDIO_CAPTURE_ENABLED=false
VISION_ENABLED=false
VISION_CLIENT_ENABLED=true
VISION_SERVER_CAPTURE_ENABLED=false
VISION_MODEL=gemini-3.5-flash
VISION_MIN_INTERVAL_CALLS=20

# ── Billing (Paystack) ───────────────────────────────────────────────────────
# Paystack is the only provider; PAYMENTS_PROVIDER=demo was removed.
PAYMENTS_PROVIDER=paystack
PAYSTACK_SECRET_KEY=<paystack-secret-key>
# This merchant has USD disabled on Paystack; keep NGN consistent with the
# local account. If Paystack enables USD for you, change all three together.
PAYSTACK_CURRENCY=NGN
PLUS_PRICE_AMOUNT=2250000
PLUS_PRICE_DISPLAY=₦22,500
FREE_MONTHLY_SESSIONS=3
FREE_MONTHLY_SCRIPTS=3

# ── Account email (optional) ────────────────────────────────────────────────
# Email is intentionally OFF until a verified sending domain is available.
# Signup and coaching work without it; password recovery returns a generic
# response but cannot deliver a reset link until a provider is configured.
REQUIRE_EMAIL_VERIFICATION=false
# When a domain is verified, use Resend's HTTPS API (works on Render Free):
# EMAIL_PROVIDER=resend
# EMAIL_FROM=PitchPilot <no-reply@your-domain.com>
# RESEND_API_KEY=<resend-key>
# On a VPS with SMTP instead, uncomment:
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=PitchPilot <no-reply@your-domain.com>
# SMTP_HOST=smtp.your-domain.com
# SMTP_PORT=587
# SMTP_USERNAME=<smtp-user>
# SMTP_PASSWORD=<smtp-password>
# SMTP_USE_TLS=true

# ── Proxy / client IP trust ──────────────────────────────────────────────────
# true only when the API is reachable exclusively through a trusted proxy
# (Render/nginx). The limiter reads the rightmost X-Forwarded-For entry.
TRUST_PROXY_HEADERS=true
