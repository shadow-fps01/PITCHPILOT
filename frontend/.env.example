# PitchPilot frontend environment
# In dev, leave this unset: Vite proxies same-origin /api requests to the
# FastAPI backend on :8000 (see vite.config.ts). Only set this when the
# backend runs on a different origin.
VITE_API_BASE_URL=

# The app ships built-in public pages at /?view=privacy, /?view=terms,
# /?view=refunds and /?view=support. Leave these unset to use them. Set them
# only to point the consent dialog at external copies.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# Support inbox shown on the built-in support page.
VITE_SUPPORT_EMAIL=support@pitchpilot.app
